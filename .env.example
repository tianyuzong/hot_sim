# Select openai (Responses API), codex (installed CLI), or deterministic (offline rules).
THERMOFLOW_PLANNER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Codex mode reuses its own config.toml and login; OPENAI_API_KEY is not required.
# Empty THERMOFLOW_CODEX_HOME uses CODEX_HOME, then the CLI user's .codex directory.
THERMOFLOW_CODEX_EXECUTABLE=codex
THERMOFLOW_CODEX_HOME=
THERMOFLOW_CODEX_TIMEOUT_SECONDS=120

# 保留最近 40 条建模对话。false 时只保存结构化草案、建议与确认记录，不保存新对话文本。
# 修改此选项不会主动清除其他既有研究或备份中的历史对话。
THERMOFLOW_RETAIN_MODELING_HISTORY=true

# 独立的参数填写 Agent：glm 使用智谱；inherit 沿用当前规划器。
# 不改变创建研究的规划器或完成研究后的优化 Agent。
THERMOFLOW_MODELING_PROVIDER=glm
ZHIPU_API_KEY=
# 同时支持 ZAI_API_KEY。只接受开放平台 API Key，不接受 enc:v1: 登录凭据。
THERMOFLOW_GLM_MODEL=glm-5.2
THERMOFLOW_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
THERMOFLOW_GLM_TIMEOUT_SECONDS=60

# The cloned CadFlow repository is discovered at ../CadFlow by default.
CADFLOW_REPO=../CadFlow
THERMOFLOW_DATA_DIR=./data
THERMOFLOW_MAX_UPLOAD_BYTES=104857600

# auto 优先使用 CUDA，失败时回退 CPU；A800 生产部署应设为 cuda，禁止静默回退。
THERMOFLOW_COMPUTE=auto
THERMOFLOW_HOST=127.0.0.1
THERMOFLOW_PORT=8000

# 后台计算进程数 1-4、等待队列 0-100、运行超时 1-7200 秒。
# 同一数据目录仅运行一个 API 服务进程；排队等待不计入运行超时。
THERMOFLOW_TASK_WORKERS=1
THERMOFLOW_TASK_QUEUE_LIMIT=8
THERMOFLOW_TASK_TIMEOUT_SECONDS=900
