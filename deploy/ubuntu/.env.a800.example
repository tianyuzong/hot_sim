# A800 上先用确定性补齐，配置 OPENAI_API_KEY 后可切换为 openai。
THERMOFLOW_PLANNER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# 生产节点要求 CUDA；不可用时让任务明确失败，不静默回退 CPU。
THERMOFLOW_COMPUTE=cuda
CUDA_VISIBLE_DEVICES=0

THERMOFLOW_HOST=127.0.0.1
THERMOFLOW_PORT=8000
THERMOFLOW_DATA_DIR=/home/zongtianyu/data44T/zongtianyudata/thermoflow/shared/data
THERMOFLOW_MAX_UPLOAD_BYTES=104857600
THERMOFLOW_TASK_WORKERS=1
THERMOFLOW_TASK_QUEUE_LIMIT=8
THERMOFLOW_TASK_TIMEOUT_SECONDS=900
CADFLOW_REPO=/home/zongtianyu/data44T/zongtianyudata/thermoflow/shared/CadFlow
